{
  "name": "kajamite-ui",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "prettier --check src build.mjs && tsc --noEmit && node build.mjs --check",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src build.mjs"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "packageManager": "npm@10.9.8"
}
